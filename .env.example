# Скопируйте в .env (он не попадает в Git) и задайте свой пароль.
# Значения ниже: только для локальной разработки, не используйте их на сервере.

POSTGRES_USER=sushi
POSTGRES_PASSWORD=change-me
POSTGRES_DB=sushi_shop
POSTGRES_PORT=5432

# Должен совпадать с значениями выше (пароль с символами вроде @ или / нужно URL-кодировать)
DATABASE_URL=postgresql://sushi:change-me@localhost:5432/sushi_shop

# Необязательно: адрес тестовой БД для e2e-тестов API. По умолчанию это DATABASE_URL с именем БД + "_test"
# (создаётся автоматически, имя обязательно должно оканчиваться на _test).
# TEST_DATABASE_URL=postgresql://sushi:change-me@localhost:5432/sushi_shop_test

# API: origin frontend, которому разрешены браузерные запросы (CORS), через запятую, без "*".
# Пусто — CORS выключен. Для локальной разработки Next.js:
WEB_ORIGINS=http://localhost:3000

# Только для Vercel (локально не задавайте): префикс маршрутов API. Vercel Services не срезает /api,
# поэтому там API_PREFIX=/api; Next.js добавляет тот же префикс к серверным запросам. См. README, раздел Deployment.
# API_PREFIX=/api
