# Скопируйте в .env.local (он не попадает в Git).

# Адрес NestJS API для серверных запросов Next.js (Server Components). В браузер не попадает.
API_URL=http://localhost:3001

# Публичный адрес API для запросов из браузера (корзина). Попадает в клиентский bundle:
# секретов здесь быть не должно. Origin этого сайта должен быть в WEB_ORIGINS API (см. корневой .env.example).
NEXT_PUBLIC_API_URL=http://localhost:3001

# Vercel Services (см. README, Deployment): API_URL приходит из Service Binding, задавать его не нужно;
# NEXT_PUBLIC_API_URL=/api (тот же origin, без CORS); API_PREFIX=/api (префикс серверных запросов).
# Локально эти значения не нужны.
